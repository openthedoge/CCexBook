<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.Light">

        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.ImportActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <!-- 微信/QQ/钉钉/文件管理器等「用其他应用打开」题库文件 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/txt" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- 系统「分享到本应用」 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/txt" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.BankHomeActivity" />
        <activity android:name=".ui.PracticeActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ExamConfigActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ExamActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ExamResultActivity" />
        <activity android:name=".ui.QuestionListActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.EditQuestionActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.AppendQuestionsActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ChangelogActivity" />
        <activity android:name=".ui.StatsActivity" />
        <activity android:name=".ui.ExportExamActivity" android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.SnakeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.ImportEntryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
