<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/qzBg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_topbar">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="‹"
            android:textColor="?attr/qzOnPrimary"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="导入题库"
            android:textColor="?attr/qzOnPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/entryFile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_card_ripple"
                android:gravity="center"
                android:text="从文件导入"
                android:textColor="?attr/qzPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/entryPaste"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_ripple"
                android:gravity="center"
                android:text="粘贴文本导入"
                android:textColor="?attr/qzPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/entryDirect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_ripple"
                android:gravity="center"
                android:text="直接添加题目"
                android:textColor="?attr/qzPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="3dp"
                android:text="你可以尝试直接导入你的文件或者粘贴你的题目先看看效果，如果有问题再看下方说明"
                android:textColor="?attr/qzPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="基本的文字模板：\n1. 题目\nA. 选项  B. 选项  C. 选项\n答案：A\n\n· 题干单独一行，选项可从 A 写在同一行\n· 判断题答案直接写 对 / 错（同样题干单独一行），多选写 ABD\n· 填空题多个空用 | 分隔，如 7|传输层\n\n模板获取：首页「生成示例」→「直接导出模板」或「分享模板」\n导入前会先预览，确认后才写入题库"
                android:textColor="?attr/qzTextSub"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
