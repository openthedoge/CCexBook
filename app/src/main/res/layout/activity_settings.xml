            <!-- ========== 关于 ========== -->
            <LinearLayout
                android:id="@+id/secAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView android:id="@+id/aboutVersion"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/ui_3"
                    android:textColor="?attr/qzText"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView android:id="@+id/aboutFork"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="基于 lssudi 的紫若灵刷题练习 v1.13.0 二次创作"
                    android:textColor="?attr/qzText"
                    android:textSize="13sp" />

                <TextView android:id="@+id/aboutThanks"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="感谢 lssudi 的付出与无私贡献，让我有动机与动力完成一个我想做完的应用！"
                    android:textColor="?attr/qzPrimary"
                    android:textSize="13sp" />

                <TextView android:id="@+id/aboutAuthor2"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:text="当前开发者：CC(openthedoge)"
                    android:textColor="?attr/qzTextSub"
                    android:textSize="13sp" />

                <TextView android:id="@+id/aboutUpdates"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp"
                    android:text="本版相对原版有多处功能与 UI 的增加与改动，具体可见更新日志"
                    android:textColor="?attr/qzText"
                    android:textSize="13sp" />

                <TextView android:id="@+id/aboutChangelogEntry"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
