                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnSettingsBack"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:paddingEnd="12dp"
                    android:text="‹ 返回"
                    android:textColor="?attr/qzPrimary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/settingsSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/qzText"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ========== 首屏：分组入口 ========== -->
            <LinearLayout
                android:id="@+id/secMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowAppearance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_ripple"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_41"
                            android:textColor="?attr/qzText"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/subAppearance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="?attr/qzTextSub"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?attr/qzTextSub"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowBehavior"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_ripple"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_30"
                            android:textColor="?attr/qzText"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/subBehavior"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="?attr/qzTextSub"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?attr/qzTextSub"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_ripple"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_65"
                            android:textColor="?attr/qzText"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/subData"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="?attr/qzTextSub"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?attr/qzTextSub"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowReset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_ripple"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_131"
                            android:textColor="?attr/qzText"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/subReset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="?attr/qzTextSub"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?attr/qzTextSub"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========== 外观 ========== -->
            <LinearLayout
                android:id="@+id/secAppearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/ui_120"
                        android:textColor="?attr/qzText"
                        android:textSize="15sp" />

                    <RadioGroup
                        android:id="@+id/langGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/langSystem"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_123" />

                        <RadioButton
                            android:id="@+id/langZh"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_9" />

                        <RadioButton
                            android:id="@+id/langEn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="English" />
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@android:color/transparent"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/ui_10"
                        android:textColor="?attr/qzText"
                        android:textSize="15sp" />
                    <LinearLayout
                        android:id="@+id/themeSeg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/ui_11"
                        android:textColor="?attr/qzText"
                        android:textSize="15sp" />
                    <LinearLayout
                        android:id="@+id/colorDots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/ui_45"
                        android:textColor="?attr/qzText"
                        android:textSize="15sp" />
                    <LinearLayout
                        android:id="@+id/fontSeg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="4dp"
                    android:text="动画速度"
                    android:textColor="?attr/qzText"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/animSeg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- ========== 刷题行为 ========== -->
            <LinearLayout
                android:id="@+id/secBehavior"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_99"
                            android:textColor="?attr/qzText"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/swAutoNext"
                            android:layout_width="64dp"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:text="关"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_103"
                            android:textColor="?attr/qzText"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/swHaptic"
                            android:layout_width="64dp"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:text="关"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_98"
                            android:textColor="?attr/qzText"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/swSound"
                            android:layout_width="64dp"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:text="关"
                            android:textSize="13sp" />
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnReplaceSound"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_card_ripple"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="替换音效"
                            android:textColor="?attr/qzPrimary"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btnSoundTest"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/ui_119"
                            android:textColor="?attr/qzPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_134"
                            android:textColor="?attr/qzText"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/swShuffle"
                            android:layout_width="64dp"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:text="关"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_100"
                            android:textColor="?attr/qzText"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/swWrongRemove"
                            android:layout_width="64dp"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:text="关"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_96"
                            android:textColor="?attr/qzText"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/swAnalysis"
                            android:layout_width="64dp"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:text="关"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="专注模式（隐藏统计）"
                            android:textColor="?attr/qzText"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/swFocus"
                            android:layout_width="64dp"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:text="关"
                            android:textSize="13sp" />
                    </LinearLayout>



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="背题模式显示「自动背题」悬浮球"
                            android:textColor="?attr/qzText"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/swAutoBall"
                            android:layout_width="64dp"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:text="关"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ========== 数据管理 ========== -->
            <LinearLayout
                android:id="@+id/secData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnBackupData"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_card_ripple"
                    android:gravity="center"
                    android:text="@string/ui_40"
                    android:textColor="?attr/qzPrimary"
                    android:textSize="15sp" />

                                <TextView
                    android:id="@+id/btnRestoreData"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_ripple"
                    android:gravity="center"
                    android:text="@string/ui_14"
                    android:textColor="?attr/qzPrimary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnRestoreOriginal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_ripple"
                    android:gravity="center"
                    android:text="@string/ui_56"
                    android:textColor="?attr/qzPrimary"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnDeleteOriginal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_ripple"
                    android:gravity="center"
                    android:text="@string/ui_27"
                    android:textColor="?attr/qzRed"
                    android:textSize="15sp"
                    android:visibility="gone" />
            

<LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="生命周期日志"
                        android:textColor="?attr/qzText"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/swLifecycle"
                        android:layout_width="64dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:text="开"
                        android:textSize="13sp" />
                </LinearLayout>
                </LinearLayout>

            <!-- ========== 重置选项 ========== -->
            <LinearLayout
                android:id="@+id/secReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnClearRecords"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_card_ripple"
                    android:gravity="center"
                    android:text="@string/ui_84"
                    android:textColor="?attr/qzPrimary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnClearWrongs"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_ripple"
                    android:gravity="center"
                    android:text="@string/ui_86"
                    android:textColor="?attr/qzPrimary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnClearFavs"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_ripple"
                    android:gravity="center"
                    android:text="@string/ui_83"
                    android:textColor="?attr/qzPrimary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnClearStats"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_ripple"
                    android:gravity="center"
                    android:text="@string/ui_85"
                    android:textColor="?attr/qzPrimary"
                    android:textSize="15sp" />
